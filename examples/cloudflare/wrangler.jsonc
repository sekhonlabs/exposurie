{
  "name": "exposurie-brain",
  "main": "worker.js",
  "compatibility_date": "2026-11-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "exposurie-brain",
      "database_id": "REPLACE_WITH_YOUR_DATABASE_ID",
      "migrations_dir": "migrations",
    },
  ],
  "vars": {
    "PUBLIC_ORIGIN": "https://brain.example",
    "OAUTH_ISSUER": "https://login.example/",
    "BRAIN_TIME_ZONE": "UTC",
  },
}
