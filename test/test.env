# Loaded by `npm test` via node --env-file. See src/package-removal.js.
#
# On a machine where the package is LINKED (npm link, which is how this repo is
# developed), a test run and a real run are indistinguishable: the binary on
# PATH is real, npm really placed it, and it really is the copy executing. Every
# structural guard therefore says "yes, remove it" -- correctly. So the suite
# needs to say out loud that it is a suite.
#
# This is set ONLY here. A real user never has it, and nothing in src/ sets it.
EXPOSURIE_SKIP_PACKAGE_REMOVAL=1

# The same, for `update`: `npm install -g` would put the package onto this
# machine. See src/package-update.js.
EXPOSURIE_SKIP_PACKAGE_UPDATE=1
